{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "YOUR_CONNECTION_STRING_HERE"
    },

    "AuthSettings": {
        "Key": "YOUR_SECRET_JWT_KEY_HERE_MIN_32_CHARS",
        "Issuer": "MedScopeAPI",
        "Audience": "MedScopeClient",
        "ExpiryInMinutes": 60
    },
    "EmailSettings": {
        "Email": "YOUR_EMAIL_HERE",
        "Password": "YOUR_APP_PASSWORD_HERE",
        "Host": "smtp.gmail.com",
        "Port": 587
    }
}